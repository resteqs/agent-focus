{
  "manifest_version": 3,
  "name": "Agent Focus",
  "version": "1.0.0",
  "description": "Sends distracting tabs to the Agent Focus wait page while your coding agent works.",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:7842/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "agent-focus@resteqs.github.io",
      "strict_min_version": "121.0"
    }
  }
}
