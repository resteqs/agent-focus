#!/bin/sh
# Command-line control for the Agent Focus daemon.

PORT="${AGENT_FOCUS_PORT:-7842}"
BASE="http://127.0.0.1:${PORT}"
DATA_DIR="${AGENT_FOCUS_DATA_DIR:-$HOME/.local/share/agent-focus}"
PLIST="$HOME/Library/LaunchAgents/com.agent-focus.daemon.plist"
UNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/agent-focus.service"
OS="$(uname -s)"

# Open a URL in the default browser, or in Safari on macOS when asked.
open_url() {
  if [ "$OS" = "Darwin" ]; then
    if [ "${2:-}" = "safari" ]; then open -a Safari "$1"; else open "$1"; fi
  else
    xdg-open "$1" >/dev/null 2>&1 &
  fi
}
VENV_PY="$DATA_DIR/venv/bin/python3"
if [ -x "$VENV_PY" ]; then
  PY_BIN="$VENV_PY"
else
  PY_BIN="$(command -v python3 2>/dev/null || echo /opt/homebrew/bin/python3)"
fi

case "${1:-status}" in
  status)
    curl -s "$BASE/api/status" | "$PY_BIN" -m json.tool 2>/dev/null || echo "Agent Focus daemon is not running."
    ;;
  on)
    curl -s -X POST -H "Content-Type: application/json" -d '{"enabled":true}' "$BASE/api/focus" >/dev/null && echo "Always-block ON."
    ;;
  off)
    curl -s -X POST -H "Content-Type: application/json" -d '{"enabled":false}' "$BASE/api/focus" >/dev/null && echo "Always-block OFF."
    ;;
  clear)
    curl -s -X POST "$BASE/api/agent/clear" >/dev/null && echo "Cleared all active agent sessions."
    ;;
  pause)
    # Kept for scripts; the web UI no longer offers a global pause.
    MINS="${2:-10}"
    SECS=$((MINS * 60))
    curl -s -X POST -H "Content-Type: application/json" -d "{\"seconds\":$SECS}" "$BASE/api/pause" >/dev/null && echo "Paused blocking for ${MINS} min."
    ;;
  resume)
    curl -s -X POST -H "Content-Type: application/json" -d '{"seconds":0}' "$BASE/api/pause" >/dev/null && echo "Resumed blocking."
    ;;
  open)
    open_url "$BASE"
    ;;
  anki)
    SUB="${2:-status}"
    shift 2 2>/dev/null || true
    case "$SUB" in
      status)
        curl -s "$BASE/api/anki/account" | "$PY_BIN" -m json.tool 2>/dev/null || echo "Agent Focus daemon is not running."
        ;;
      login)
        ENDPOINT=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --endpoint) ENDPOINT="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        "$PY_BIN" - "$BASE" "$ENDPOINT" <<'PY'
import getpass, json, sys, urllib.error, urllib.request
base, endpoint = sys.argv[1], sys.argv[2]
email = input("AnkiWeb email or sync server username: ").strip()
password = getpass.getpass("Password (not stored): ")


def post(path, body, timeout):
    req = urllib.request.Request(f"{base}{path}", data=json.dumps(body).encode("utf-8"),
                                 headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def fail(prefix, e):
    error = json.loads(e.read().decode("utf-8", errors="replace") or "{}").get("error", e.reason)
    sys.exit(f"{prefix}: {error}")


step = "Sign-in failed"
try:
    account = post("/api/anki/login", {"email": email, "password": password, "endpoint": endpoint}, 60)["account"]
    print(f"Signed in as {account['account']} on {account['endpoint_label']}. Downloading your decks...")
    # Cards first; images keep arriving in the background while the daemon runs.
    step = "Sync failed"
    post("/api/anki/sync", {"media": False, "background_media": True, "on_conflict": "download"}, 600)
    print("Collection synced. Media is syncing in the background.")
except urllib.error.HTTPError as e:
    fail(step, e)
except urllib.error.URLError:
    sys.exit("Agent Focus is not running. Start it with: agent-focus restart")
PY
        ;;
      sync)
        curl -s -X POST -H "Content-Type: application/json" -d '{}' "$BASE/api/anki/sync" | "$PY_BIN" -m json.tool
        ;;
      logout)
        curl -s -X POST "$BASE/api/anki/logout" | "$PY_BIN" -m json.tool
        ;;
      *)
        echo "Usage: agent-focus anki [status|login [--endpoint URL]|sync|logout]"
        ;;
    esac
    ;;
  demo)
    SECS="${2:-35}"
    SID="demo-$(date +%s)"
    curl -s -X POST -H "Content-Type: application/json" \
      -d "{\"session_id\":\"claude:$SID\",\"agent\":\"claude\",\"cwd\":\"$PWD\"}" \
      "$BASE/api/agent/start" >/dev/null
    open_url "$BASE/?from=https%3A%2F%2Fmail.proton.me&domain=mail.proton.me&t=$(date +%s)" safari
    echo "Demo run started (claude:$SID) for ${SECS}s. Opened the wait-state screen."
    (
      sleep "$SECS"
      curl -s -X POST -H "Content-Type: application/json" \
        -d "{\"session_id\":\"claude:$SID\",\"agent\":\"claude\"}" \
        "$BASE/api/agent/stop" >/dev/null 2>&1
    ) >/dev/null 2>&1 &
    ;;
  restart)
    if [ "$OS" = "Linux" ]; then
      if [ ! -f "$UNIT" ]; then
        echo "No systemd user service found. Run ./install.sh first." >&2
        exit 1
      fi
      systemctl --user restart agent-focus && echo "Restarted Agent Focus."
      exit $?
    fi
    if [ ! -f "$PLIST" ]; then
      echo "No LaunchAgent found. Run ./install.sh first." >&2
      exit 1
    fi
    launchctl kickstart -k "gui/$(id -u)/com.agent-focus.daemon" 2>/dev/null || {
      launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$PLIST"
    }
    echo "Restarted Agent Focus."
    ;;
  logs)
    tail -n 40 "$DATA_DIR/server.log" 2>/dev/null || echo "No logs yet."
    ;;
  *)
    echo "Usage: agent-focus [status|anki [status|login [--endpoint URL]|sync|logout]|demo [secs]|on|off|clear|pause [mins]|resume|open|restart|logs]"
    ;;
esac
